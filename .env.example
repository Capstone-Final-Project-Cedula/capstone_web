# Copy to .env (local) or set on the web host. Never commit .env.
#
# Address of the CeduSync backend API, ending in /api.
# Read at BUILD time: `npm run build` bakes it into the bundle, so after changing it
# you must build (and deploy) again. Changing it on the host without a rebuild does nothing.
#
# Deployed: must be https (the mic and QR camera only work on https pages, and an
# https page cannot call an http API).
# Local: leave it unset and the app uses http://<this computer>:8000/api.
REACT_APP_API_URL=https://<backend-address>/api
